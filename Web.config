<?xml version="1.0" encoding="utf-8"?>
<!--
  Painel dos tenants da Whera.
  Não acessa banco: tudo passa pela API Whera, chamada pelo servidor (sem CORS).
  -->
<configuration>

	<appSettings>
		<!--Endereço da API Whera (sem barra no final). Produção (Render); local: http://localhost:5128-->
		<add key="WheraApiUrl" value="https://whera-api.onrender.com" />
		<!--Tempo limite das chamadas à API, em segundos (o Render "acorda" em até ~50 s na primeira chamada)-->
		<add key="WheraApiTimeout" value="90" />
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<!-- Todas as páginas WebForms e respostas da aplicação usam UTF-8, inclusive textos em português. -->
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="pt-BR" uiCulture="pt-BR" />
		<!--Envio até 101 MB (KB) e até 10 min: o ZIP do "Criar em lote" vai até 100 MB, mais o resto do formulário-->
		<httpRuntime targetFramework="4.8" maxRequestLength="103424" executionTimeout="600" enableVersionHeader="false" />
		<customErrors mode="RemoteOnly" defaultRedirect="~/AcessoSeguro/Login.aspx" />
		<!--A sessão do site só guarda o token; a validade efetiva vem da API-->
		<sessionState timeout="30" />
		<httpCookies httpOnlyCookies="true" />
		<pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" validateRequest="true">
			<controls>
				<add tagPrefix="asp" namespace="System.Web.UI" assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
			</controls>
		</pages>
	</system.web>

	<system.webServer>
		<security>
			<requestFiltering>
				<!--Mesmo limite do httpRuntime, em bytes (101 MB); sem isso o IIS corta em ~28,6 MB-->
				<requestLimits maxAllowedContentLength="105906176" />
			</requestFiltering>
		</security>
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.aspx" />
			</files>
		</defaultDocument>
		<httpProtocol>
			<customHeaders>
				<add name="X-Frame-Options" value="DENY" />
				<add name="X-Content-Type-Options" value="nosniff" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>

</configuration>
