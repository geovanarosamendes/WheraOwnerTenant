<%@ Page Language="C#" AutoEventWireup="true" CodeFile="CadastroInicial.aspx.cs" Inherits="AcessoSeguro_CadastroInicial" %>
<!DOCTYPE html><html lang="pt-br"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Cadastro da empresa | Whera</title><link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700" /><link href="~/CSS/site.css" rel="stylesheet" type="text/css" /></head><body class="pagina-login"><form id="formCadastro" runat="server"><div class="caixa-login"><h1>Começar no Whera</h1><p class="dica">Conclua o pré-cadastro ou use um código recebido para vincular a empresa à sua conta.</p><asp:Panel ID="pnlErro" runat="server" CssClass="erro" Visible="false"><asp:Literal ID="litErro" runat="server" /></asp:Panel><asp:Panel ID="pnlSucesso" runat="server" CssClass="sucesso-msg" Visible="false"><asp:Literal ID="litSucesso" runat="server" /></asp:Panel><asp:Panel ID="pnlCriar" runat="server"><h2>Solicitar pré-cadastro</h2><label class="campo"><span>Nome da empresa</span><asp:TextBox ID="txtNomeEmpresa" runat="server" MaxLength="150" /></label><label class="campo"><span>CNPJ</span><asp:TextBox ID="txtCnpj" runat="server" MaxLength="18" /></label><label class="campo"><span>Nome do contato</span><asp:TextBox ID="txtNomeContato" runat="server" MaxLength="150" /></label><label class="campo"><span>E-mail do proprietário</span><asp:TextBox ID="txtEmailCriar" runat="server" TextMode="Email" MaxLength="254" /></label><label class="campo"><span>Modalidade</span><asp:DropDownList ID="ddlModalidade" runat="server"><asp:ListItem Text="Física" Value="Fisica" /><asp:ListItem Text="Online" Value="Online" /><asp:ListItem Text="Híbrida" Value="Hibrida" /></asp:DropDownList></label><asp:Button ID="btnCriar" runat="server" Text="Criar pré-cadastro" CssClass="botao" OnClick="btnCriar_Click" /><hr /><h2>Já tenho um código</h2><label class="campo"><span>Empresa ID</span><asp:TextBox ID="txtEmpresaId" runat="server" /></label><label class="campo"><span>Código de continuação</span><asp:TextBox ID="txtCodigo" runat="server" /></label><asp:Button ID="btnContinuar" runat="server" Text="Continuar cadastro" CssClass="botao-secundario" OnClick="btnContinuar_Click" /></asp:Panel><asp:Panel ID="pnlVincular" runat="server" Visible="false"><h2>Vincular sua conta</h2><p>Empresa: <strong><asp:Literal ID="litEmpresaId" runat="server" /></strong></p><label class="campo"><span>Nome</span><asp:TextBox ID="txtNome" runat="server" MaxLength="150" /></label><label class="campo"><span>E-mail</span><asp:TextBox ID="txtEmail" runat="server" TextMode="Email" MaxLength="254" /></label><label class="campo"><span>Senha da conta pública</span><asp:TextBox ID="txtSenha" runat="server" TextMode="Password" MaxLength="128" /></label><label class="campo"><span>Segunda senha/PIN administrativo</span><asp:TextBox ID="txtSegundaSenha" runat="server" TextMode="Password" MaxLength="128" /></label><asp:Button ID="btnVincular" runat="server" Text="Criar vínculo Tenant" CssClass="botao" OnClick="btnVincular_Click" /></asp:Panel><p><a href="~/AcessoSeguro/Login.aspx">Já tenho acesso</a></p></div></form></body></html>
