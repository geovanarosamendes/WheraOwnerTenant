<%@ Page Language="C#" MasterPageFile="~/Adm/MasterPage.master" AutoEventWireup="true" CodeFile="Catalogo.aspx.cs" Inherits="Adm_Catalogo" %>
<asp:Content ID="TituloPagina" ContentPlaceHolderID="Titulo" runat="server">Catálogo | Whera Tenant</asp:Content>
<asp:Content ID="CorpoPagina" ContentPlaceHolderID="Conteudo" runat="server"><div class="cabecalho-pagina"><div><span class="sobretitulo">MINHA EMPRESA</span><h1>Mini catálogo</h1><p>Até seis fotos de produtos ou serviços, com título e link opcional.</p></div></div><asp:Panel ID="pnlErro" runat="server" CssClass="erro" Visible="false"><asp:Literal ID="litErro" runat="server" /></asp:Panel><asp:Panel ID="pnlSucesso" runat="server" CssClass="sucesso-msg" Visible="false"><asp:Literal ID="litSucesso" runat="server" /></asp:Panel><asp:Panel ID="pnlConteudo" runat="server" CssClass="painel" Visible="false"><label class="campo"><span>Adicionar item</span><asp:FileUpload ID="fuImagem" runat="server" accept="image/jpeg,image/png,image/webp" /><asp:Button ID="btnAdicionar" runat="server" Text="Enviar foto" CssClass="botao-secundario" OnClick="btnAdicionar_Click" /></label><asp:Repeater ID="rptCatalogo" runat="server"><ItemTemplate><div class="gestao-linha"><asp:HiddenField ID="hidImagem" runat="server" Value='<%# Eval("Imagem") %>' /><img src="<%# HttpUtility.HtmlAttributeEncode(Convert.ToString(Eval("Imagem"))) %>" width="120" alt="Item do catálogo" /><label class="campo"><span>Título</span><asp:TextBox ID="txtTitulo" runat="server" Text='<%# Eval("Titulo") %>' MaxLength="80" /></label><label class="campo"><span>Link</span><asp:TextBox ID="txtLink" runat="server" Text='<%# Eval("Link") %>' MaxLength="500" /></label></div></ItemTemplate></asp:Repeater><asp:Button ID="btnSalvar" runat="server" Text="Salvar catálogo" CssClass="botao-primario" OnClick="btnSalvar_Click" /></asp:Panel></asp:Content>
