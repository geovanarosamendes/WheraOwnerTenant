<%@ Page Language="C#" MasterPageFile="~/Adm/MasterPage.master" AutoEventWireup="true" CodeFile="Atendentes.aspx.cs" Inherits="Adm_Atendentes" %>
<asp:Content ID="TituloPagina" ContentPlaceHolderID="Titulo" runat="server">Atendentes | Whera Tenant</asp:Content>
<asp:Content ID="CorpoPagina" ContentPlaceHolderID="Conteudo" runat="server"><div class="cabecalho-pagina"><div><span class="sobretitulo">MINHA EMPRESA</span><h1>Atendentes</h1><p>Cadastre os contatos comerciais que aparecem no perfil público.</p></div></div><asp:Panel ID="pnlErro" runat="server" CssClass="erro" Visible="false"><asp:Literal ID="litErro" runat="server" /></asp:Panel><asp:Panel ID="pnlSucesso" runat="server" CssClass="sucesso-msg" Visible="false"><asp:Literal ID="litSucesso" runat="server" /></asp:Panel><asp:Panel ID="pnlSemEmpresa" runat="server" CssClass="painel" Visible="false"><h2>Nenhuma empresa vinculada</h2></asp:Panel><asp:Panel ID="pnlConteudo" runat="server" Visible="false"><div class="painel"><div class="painel-cabecalho"><h2><asp:Literal ID="litEmpresa" runat="server" /></h2><p>O atendente não possui login nesta fase; ele é apenas um contato comercial.</p></div><div class="grade-form"><asp:HiddenField ID="hidId" runat="server" /><label class="campo"><span>Nome público <sup>*</sup></span><asp:TextBox ID="txtNome" runat="server" MaxLength="100" /></label><label class="campo"><span>Função</span><asp:TextBox ID="txtFuncao" runat="server" MaxLength="80" placeholder="Vendas, suporte..." /></label><label class="campo"><span>Telefone</span><asp:TextBox ID="txtTelefone" runat="server" MaxLength="20" /></label><label class="campo"><span>WhatsApp</span><asp:TextBox ID="txtWhatsApp" runat="server" MaxLength="30" /></label></div><div class="acoes-form"><asp:Button ID="btnSalvar" runat="server" Text="Salvar atendente" CssClass="botao-primario" OnClick="btnSalvar_Click" /><asp:Button ID="btnNovo" runat="server" Text="Limpar formulário" CssClass="botao-secundario" OnClick="btnNovo_Click" /></div></div><div class="painel"><div class="painel-cabecalho"><h2>Ordem de exibição</h2><p>Use os controles para ordenar os contatos do perfil.</p></div><asp:Repeater ID="rptAtendentes" runat="server"><HeaderTemplate><div class="tabela-rolagem"><table class="tabela"><thead><tr><th>Contato</th><th>Meios</th><th>Ações</th></tr></thead><tbody></HeaderTemplate><ItemTemplate><tr><td><strong><%# HttpUtility.HtmlEncode(Eval("NomePublico")) %></strong><small><%# HttpUtility.HtmlEncode(Eval("Funcao")) %></small></td><td><%# HttpUtility.HtmlEncode(Meios(Eval("Telefone"), Eval("WhatsApp"))) %></td><td><asp:LinkButton ID="btnEditar" runat="server" CssClass="botao-secundario" CommandArgument='<%# Eval("Id") %>' OnCommand="btnEditar_Command">Editar</asp:LinkButton> <asp:LinkButton ID="btnSubir" runat="server" CssClass="botao-secundario" CommandArgument='<%# "up|" + Eval("Id") %>' OnCommand="btnOrdem_Command">↑</asp:LinkButton> <asp:LinkButton ID="btnDescer" runat="server" CssClass="botao-secundario" CommandArgument='<%# "down|" + Eval("Id") %>' OnCommand="btnOrdem_Command">↓</asp:LinkButton> <asp:LinkButton ID="btnRemover" runat="server" CssClass="botao-perigo" CommandArgument='<%# Eval("Id") %>' OnCommand="btnRemover_Command" OnClientClick="return confirm('Remover este atendente?');">Remover</asp:LinkButton></td></tr></ItemTemplate><FooterTemplate></tbody></table></div></FooterTemplate></asp:Repeater><asp:Panel ID="pnlVazio" runat="server" CssClass="tabela-vazia" Visible="false">Nenhum atendente cadastrado.</asp:Panel></div></asp:Panel></asp:Content>
