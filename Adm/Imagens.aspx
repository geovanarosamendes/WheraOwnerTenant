<%@ Page Language="C#" MasterPageFile="~/Adm/MasterPage.master" AutoEventWireup="true" CodeFile="Imagens.aspx.cs" Inherits="Adm_Imagens" %>
<asp:Content ID="TituloPagina" ContentPlaceHolderID="Titulo" runat="server">Imagens | Whera Tenant</asp:Content>
<asp:Content ID="CorpoPagina" ContentPlaceHolderID="Conteudo" runat="server"><div class="cabecalho-pagina"><div><span class="sobretitulo">MINHA EMPRESA</span><h1>Imagens e identidade</h1><p>Administre logo, capa, fachada e galeria do perfil público.</p></div></div><asp:Panel ID="pnlErro" runat="server" CssClass="erro" Visible="false"><asp:Literal ID="litErro" runat="server" /></asp:Panel><asp:Panel ID="pnlSucesso" runat="server" CssClass="sucesso-msg" Visible="false"><asp:Literal ID="litSucesso" runat="server" /></asp:Panel><asp:Panel ID="pnlConteudo" runat="server" CssClass="painel" Visible="false"><div class="painel-cabecalho"><h2>Enviar novas imagens</h2><p>JPG, PNG ou WebP até 5 MB. A imagem só fica pública após salvar o perfil.</p></div><div class="grade-form"><label class="campo"><span>Logo atual</span><asp:Image ID="imgLogo" runat="server" Width="120" /><asp:FileUpload ID="fuLogo" runat="server" accept="image/jpeg,image/png,image/webp" /></label><label class="campo"><span>Foto de capa atual</span><asp:Image ID="imgCapa" runat="server" Width="220" /><asp:FileUpload ID="fuCapa" runat="server" accept="image/jpeg,image/png,image/webp" /></label><label class="campo"><span>Foto da fachada atual</span><asp:Image ID="imgFachada" runat="server" Width="180" /><asp:FileUpload ID="fuFachada" runat="server" accept="image/jpeg,image/png,image/webp" /></label><label class="campo"><span>Adicionar à galeria</span><asp:FileUpload ID="fuGaleria" runat="server" accept="image/jpeg,image/png,image/webp" /></label></div><asp:Button ID="btnSalvar" runat="server" Text="Enviar e salvar imagens" CssClass="botao-primario" OnClick="btnSalvar_Click" /><h3>Galeria atual</h3><asp:Repeater ID="rptGaleria" runat="server"><ItemTemplate><img class="previa-imagem" src="<%# HttpUtility.HtmlAttributeEncode(Convert.ToString(Container.DataItem)) %>" alt="Imagem da galeria" width="140" /></ItemTemplate></asp:Repeater></asp:Panel></asp:Content>
