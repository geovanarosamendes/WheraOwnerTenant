<%@ Page Language="C#" MasterPageFile="~/Adm/MasterPage.master" AutoEventWireup="true" CodeFile="Home.aspx.cs" Inherits="Adm_Home" %>
<asp:Content ID="TituloPagina" ContentPlaceHolderID="Titulo" runat="server">Visão geral | Whera Tenant</asp:Content>
<asp:Content ID="CorpoPagina" ContentPlaceHolderID="Conteudo" runat="server">
    <div class="cabecalho-pagina"><div><span class="sobretitulo">OWNER TENANT</span><h1>Visão geral</h1><p>Resumo da empresa e dos recursos disponíveis no Whera.</p></div><asp:Button ID="btnAtualizar" runat="server" Text="Atualizar" CssClass="botao-secundario" OnClick="btnAtualizar_Click" /></div>
    <asp:Panel ID="pnlErro" runat="server" CssClass="erro" Visible="false"><asp:Literal ID="litErro" runat="server" /></asp:Panel>
    <asp:Panel ID="pnlSelecaoOwner" runat="server" CssClass="painel" Visible="false">
        <div class="painel-cabecalho"><h2>Selecionar empresa</h2><p>Como Owner, pesquise uma empresa para abrir o contexto administrativo autorizado pela API.</p></div>
        <div class="gestao-linha"><label class="campo campo-largo"><span>Nome, slug ou termo de busca</span><asp:TextBox ID="txtBuscaEmpresa" runat="server" MaxLength="100" /></label><asp:Button ID="btnBuscarEmpresa" runat="server" Text="Pesquisar" CssClass="botao-secundario" OnClick="btnBuscarEmpresa_Click" /></div>
        <label class="campo"><span>Empresa encontrada</span><asp:DropDownList ID="ddlEmpresas" runat="server" /></label>
        <asp:Button ID="btnSelecionarEmpresa" runat="server" Text="Abrir empresa" CssClass="botao-primario" OnClick="btnSelecionarEmpresa_Click" />
        <asp:Literal ID="litOwnerMensagem" runat="server" />
    </asp:Panel>
    <asp:Panel ID="pnlSemEmpresa" runat="server" CssClass="painel" Visible="false"><h2>Nenhuma empresa vinculada</h2><p>A conta autenticada ainda não possui uma empresa autorizada pela API Whera.</p></asp:Panel>
    <asp:Panel ID="pnlDashboard" runat="server" Visible="false"><div class="indicadores"><div class="indicador"><span>Empresa</span><strong><asp:Literal ID="litEmpresa" runat="server" /></strong><small><asp:Literal ID="litCidade" runat="server" /></small></div><div class="indicador sucesso"><span>Status do perfil</span><strong><asp:Literal ID="litStatus" runat="server" /></strong><small>Validado pela API Whera</small></div><div class="indicador"><span>Conteúdos</span><strong><asp:Literal ID="litConteudos" runat="server" /></strong><small>Stories e promoções cadastrados</small></div></div><div class="grade-paineis"><div class="painel"><div class="painel-cabecalho"><h2>Próximos passos</h2><p>Complete a presença digital da empresa.</p></div><ul><li><a runat="server" href="~/Adm/MinhaEmpresa.aspx">Revisar dados, contatos e endereço</a></li><li><a runat="server" href="~/Adm/Conteudos.aspx">Criar uma publicação</a></li><li><a runat="server" href="~/Adm/Gerentes.aspx">Gerenciar usuários autorizados</a></li></ul></div><div class="painel"><div class="painel-cabecalho"><h2>Integrações sociais</h2><p>Estado conforme os contratos reais da API.</p></div><p>Instagram e demais provedores ainda não possuem endpoints de conexão e métricas no backend atual.</p><a runat="server" class="painel-link" href="~/Adm/RedesSociais.aspx">Ver estado das integrações</a></div></div></asp:Panel>
</asp:Content>
