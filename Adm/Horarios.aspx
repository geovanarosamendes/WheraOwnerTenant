<asp:Content ID="CorpoPagina" ContentPlaceHolderID="Conteudo" runat="server"><div class="cabecalho-pagina"><div><span class="sobretitulo">MINHA EMPRESA</span><h1>Horários de funcionamento</h1><p>Configure os intervalos exibidos no perfil público.</p></div></div><asp:Panel ID="pnlErro" runat="server" CssClass="erro" Visible="false"><asp:Literal ID="litErro" runat="server" /></asp:Panel><asp:Panel ID="pnlSucesso" runat="server" CssClass="sucesso-msg" Visible="false"><asp:Literal ID="litSucesso" runat="server" /></asp:Panel><asp:Panel ID="pnlConteudo" runat="server" CssClass="painel" Visible="false"><div class="painel-cabecalho"><h2>Semana de funcionamento</h2><p>Deixe os dois campos vazios para marcar o dia como fechado.</p></div><div class="tabela-rolagem"><table class="tabela"><thead><tr><th>Dia</th><th>Intervalo 1</th><th>Intervalo 2</th></tr></thead><tbody><tr><td>Domingo</td><td><asp:TextBox ID="domA" runat="server" TextMode="Time" /> – <asp:TextBox ID="domF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="domA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="domF2" runat="server" TextMode="Time" /></td></tr><tr><td>Segunda-feira</td><td><asp:TextBox ID="segA" runat="server" TextMode="Time" /> – <asp:TextBox ID="segF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="segA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="segF2" runat="server" TextMode="Time" /></td></tr><tr><td>Terça-feira</td><td><asp:TextBox ID="terA" runat="server" TextMode="Time" /> – <asp:TextBox ID="terF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="terA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="terF2" runat="server" TextMode="Time" /></td></tr><tr><td>Quarta-feira</td><td><asp:TextBox ID="quaA" runat="server" TextMode="Time" /> – <asp:TextBox ID="quaF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="quaA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="quaF2" runat="server" TextMode="Time" /></td></tr><tr><td>Quinta-feira</td><td><asp:TextBox ID="quiA" runat="server" TextMode="Time" /> – <asp:TextBox ID="quiF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="quiA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="quiF2" runat="server" TextMode="Time" /></td></tr><tr><td>Sexta-feira</td><td><asp:TextBox ID="sexA" runat="server" TextMode="Time" /> – <asp:TextBox ID="sexF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="sexA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="sexF2" runat="server" TextMode="Time" /></td></tr><tr><td>Sábado</td><td><asp:TextBox ID="sabA" runat="server" TextMode="Time" /> – <asp:TextBox ID="sabF" runat="server" TextMode="Time" /></td><td><asp:TextBox ID="sabA2" runat="server" TextMode="Time" /> – <asp:TextBox ID="sabF2" runat="server" TextMode="Time" /></td></tr></tbody></table></div><asp:Button ID="btnSalvar" runat="server" Text="Salvar horários" CssClass="botao-primario" OnClick="btnSalvar_Click" /></asp:Panel></asp:Content>
