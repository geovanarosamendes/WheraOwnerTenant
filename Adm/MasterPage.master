<%@ Master Language="C#" CodeFile="MasterPage.master.cs" Inherits="Adm_MasterPage" %>
<!DOCTYPE html>
<html lang="pt-br">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="Titulo" runat="server">Whera Tenant</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700" />
    <link runat="server" href="~/CSS/site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="formPrincipal" runat="server">
        <header class="topo"><a runat="server" class="marca" href="~/Adm/Home.aspx">Whera<span>Tenant</span></a><div class="conta"><asp:Literal ID="litUsuario" runat="server" /><a runat="server" href="~/AcessoSeguro/Sair.aspx">Sair</a></div></header>
        <div class="corpo">
            <nav class="menu"><span class="menu-titulo">PAINEL DO TENANT</span><a class="<%= Ativo("Home.aspx") %>" href="~/Adm/Home.aspx">Visão geral</a><a class="<%= Ativo("MinhaEmpresa.aspx") %>" href="~/Adm/MinhaEmpresa.aspx">Minha empresa</a><a class="<%= Ativo("Previa.aspx") %>" href="~/Adm/Previa.aspx">Prévia pública</a><a class="<%= Ativo("Imagens.aspx") %>" href="~/Adm/Imagens.aspx">Imagens</a><a class="<%= Ativo("Catalogo.aspx") %>" href="~/Adm/Catalogo.aspx">Catálogo</a><a class="<%= Ativo("Horarios.aspx") %>" href="~/Adm/Horarios.aspx">Horários</a><a class="<%= Ativo("Atendentes.aspx") %>" href="~/Adm/Atendentes.aspx">Atendentes</a><a class="<%= Ativo("Conteudos.aspx") %>" href="~/Adm/Conteudos.aspx">Publicações</a><% if (WheraOwnerTenant.SessaoTenant.EhTenant) { %><a class="<%= Ativo("Gerentes.aspx") %>" href="~/Adm/Gerentes.aspx">Usuários e acesso</a><% } %><a class="<%= Ativo("RedesSociais.aspx") %>" href="~/Adm/RedesSociais.aspx">Redes sociais</a><a class="<%= Ativo("Relatorios.aspx") %>" href="~/Adm/Relatorios.aspx">Relatórios</a><a class="<%= Ativo("Configuracoes.aspx") %>" href="~/Adm/Configuracoes.aspx">Configurações</a></nav>
            <main class="conteudo"><asp:ContentPlaceHolder ID="Conteudo" runat="server" /></main>
        </div>
    </form>
</body>
</html>
